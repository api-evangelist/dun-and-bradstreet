      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 token issuance for Direct+.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "785097cc-5287-41b5-9453-64b204c8c32e",
          "name": "Generate Direct+ Access Token",
          "request": {
            "name": "Generate Direct+ Access Token",
            "description": {
              "content": "Exchange Direct+ API credentials for an OAuth 2.0 bearer access token using the client-credentials grant. The returned token is included as a Bearer authorization header on all subsequent Direct+ calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9b3f56ff-8c7c-48de-b823-3d5ebd2d01d8",
              "name": "Access token issued.",
