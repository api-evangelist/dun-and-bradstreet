                "v1",
                "data",
                "duns",
                ":duns"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "blockIDs",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of block IDs with version (e.g. companyinfo_L2_v1,principalscontacts_L1_v2)."
                },
                {
                  "disabled": false,
                  "key": "tradeUp",
                  "value": "<string>"
                }
